# Gemini cloud provider, only needed when LLM_PROVIDER=gemini
LLM_API=your_gemini_api_key_here

# Local LM Studio provider
LLM_PROVIDER=lmstudio
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Copy the exact model id from LM Studio's local server or leave unset to use
# the first loaded model.
LM_STUDIO_MODEL=your_loaded_lm_studio_model_id_here
